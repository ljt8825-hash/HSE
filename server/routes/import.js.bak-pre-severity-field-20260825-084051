// 将 Python 引擎的 ParseResult 转换为前端 preview 契约结构
// （与 /upload 返回字段完全一致：jobId/totalRows/validRows/invalidRows/preview/moduleType/sheets...）
// 这样前端在"勾选 sheet 重解"(/parse) 后拿到的结构与初次上传(/upload) 一致，
// preview 模板可直接渲染，且 jobId 不丢失（confirm 依赖它）。
function buildFrontendPreview(parseResult, jobId) {
  const sampleData = parseResult.sample_data || [];
  // 预览数据统一 camelCase 输出，与前端列表显示一致
  const preview = sampleData.map((row, i) => ({
    rowIndex: i + 1,
    data: camelKeys(row),
    errors: [],
  }));
  const totalRows = parseResult.total_rows || sampleData.length;
  return {
    jobId: jobId != null ? String(jobId) : undefined,
    totalRows,
    validRows: totalRows,
    invalidRows: 0,
    preview,
    moduleType: parseResult.module_type,
    moduleName: parseResult.module_name || parseResult.module_type,
    targetTable: parseResult.target_table,
    sheets: parseResult.sheets || [],
  };
}

// ============================================================
// POST /api/import/parse — 解析文件（管理员/安全管理）
// ============================================================
router.post('/parse', requireRole('admin', 'safety_manager'), async (req, res) => {
  try {
    const { fileRecordId, filePath, fileName, sheets } = req.body;

    // 前端(ImportModal)勾选 sheet 重解时只传 fileRecordId + sheets，
    // 这里从 file_records 反查 filePath/fileName，避免前端持有文件路径
    let _filePath = filePath;
    let _fileName = fileName;
    if ((!_filePath || !_fileName) && fileRecordId) {
      const fr = await pool.query(
        `SELECT filepath, original_name, filename FROM file_records WHERE id = $1`,
        [fileRecordId]
      );
      if (fr.rows.length) {
        _filePath = fr.rows[0].filepath;
        _fileName = fr.rows[0].original_name || fr.rows[0].filename;
      }
    }

    if (!_filePath || !_fileName) {
      return res.json(error(-1, '缺少必要参数: filePath, fileName (且 file_records 中无可用的记录)'));
    }

    // 原生导入模块优先使用 Node.js 解析
    let moduleType = null;
    if (fileRecordId) {
      const fr = await pool.query(
        'SELECT module_type FROM file_records WHERE id = $1',
        [fileRecordId]
      );
      if (fr.rows.length) {
        moduleType = fr.rows[0].module_type;
      }
    }

    if (moduleType && NATIVE_IMPORT_MODULES[moduleType]) {
      try {
        const nativeConfig = NATIVE_IMPORT_MODULES[moduleType];
        const parseResult = parseExcelNative(_filePath, nativeConfig, sheets);
        if (!parseResult.success) {
          return res.json(error(-2, parseResult.error || '文件解析失败', parseResult));
        }
        const payload = {
          jobId: String(fileRecordId),
          totalRows: parseResult.total_rows + (parseResult.error_count || 0),
          validRows: parseResult.total_rows,
          invalidRows: parseResult.error_count || 0,
          errors: parseResult.errors || [],
          preview: parseResult.preview,
          moduleType,
          moduleName: nativeConfig.moduleName,
          targetTable: nativeConfig.targetTable,
          sheets: parseResult.sheets || [],
        };
        return res.json(success(payload, `解析成功: 模块=${nativeConfig.moduleName}, 共${parseResult.total_rows}行${parseResult.error_count ? `，错误${parseResult.error_count}行` : ''}`));
      } catch (nativeErr) {
        console.error('[Import] native parse failed:', nativeErr.message);
      }
    }

    // 调用 Python 解析引擎
    const args = [
      PARSER_SCRIPT,
      '--action=parse',
      `--file-path=${_filePath}`,
      `--file-name=${_fileName}`,
    ];

    if (fileRecordId) {
      args.push(`--file-record-id=${fileRecordId}`);
    }
    // 多 sheet 支持：前端勾选的工作表列表
    if (sheets && Array.isArray(sheets) && sheets.length) {
      args.push(`--sheets=${sheets.join(',')}`);
    }

    const result = await callPython(args);

    if (result.success) {
      const payload = buildFrontendPreview(result, fileRecordId);
      res.json(success(payload, `解析成功: 模块=${result.module_name}, 表=${result.target_table}, 共${result.total_rows}行`));
    } else {
      res.json(error(-2, result.error || '解析失败', result));
    }
  } catch (err) {
    console.error('[Import] parse error:', err.message);
    res.json(error(-3, '解析异常: ' + err.message));
  }
});

