// POST /api/import/confirm — 确认入库（管理员/安全管理）
// ============================================================
router.post('/confirm', requireRole('admin', 'safety_manager'), async (req, res) => {
  try {
    const { fileRecordId, insuranceType } = req.body;
    // 审计操作人必须来自已验证的 req.user，不得信任请求体中的 operator
    const operator = req.user || null;

    if (!fileRecordId) {
      return res.json(error(-1, '缺少必要参数: fileRecordId'));
    }

    const jobId = crypto.randomUUID();

    // 先检查 file_records 中的 module_type，判断是否使用原生导入
    const fr = await pool.query(
      'SELECT module_type FROM file_records WHERE id = $1',
      [fileRecordId]
    );
    const moduleType = fr.rows[0]?.module_type;

    if (moduleType && NATIVE_IMPORT_MODULES[moduleType]) {
      const result = await confirmImportNative(fileRecordId, moduleType, operator, insuranceType);
      if (result.success) {
        const count = (result.inserted || 0) + (result.updated || 0);
        auditLog({ userId: req.user?.id, username: req.user?.username, action: 'import', module: moduleType, description: `确认导入 ${count || ''} 条数据`, ip: req.ip }).catch(() => {});
        // 任务4（提示词11）：消息按 outcome 区分，不得把 partial/failed 写成完整成功
        const msg = result.outcome === 'imported'
          ? `入库成功: 新增${result.inserted}, 更新${result.updated}`
          : result.outcome === 'partial'
            ? `部分入库完成: 新增${result.inserted}, 更新${result.updated}, 跳过${result.skipped}`
            : '入库失败，未写入记录';
        return res.json(success(result, msg));
      } else {
        return res.json(error(-2, result.error || '入库失败', result));
      }
    }

    // 调用 Python 确认入库
    const args = [
      PARSER_SCRIPT,
      '--action=confirm',
      `--job-id=${jobId}`,
      `--file-record-id=${fileRecordId}`,
      `--operator=${operator || 'web-user'}`
    ];

    const result = await callPython(args);

    if (result.success) {
      const count = (result.inserted || 0) + (result.updated || 0);
      auditLog({ userId: req.user?.id, username: req.user?.username, action: 'import', module: 'import', description: `确认导入 ${count || ''} 条数据`, ip: req.ip }).catch(() => {});
      res.json(success(result, `入库成功: 新增${result.inserted}, 更新${result.updated}, 跳过${result.skipped}`));
    } else {
      res.json(error(-2, result.error || '入库失败', result));
    }
  } catch (err) {
    console.error('[Import] confirm error:', err.message);
    res.json(error(-3, '入库异常: ' + err.message));
  }
});

