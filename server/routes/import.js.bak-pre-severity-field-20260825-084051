// GET /api/import/logs — 查询导入日志
// ============================================================
router.get('/logs', requireRole('admin', 'safety_manager'), async (req, res) => {
  try {
    const { moduleType, status, page, limit } = req.query;
    const pageNum = parseInt(page) || 1;
    const limitNum = Math.min(parseInt(limit) || 50, 200);
    const offset = (pageNum - 1) * limitNum;

    let where = ['1=1'];
    let params = [];
    let idx = 1;

    if (moduleType) {
      where.push(`module_type = $${idx++}`);
      params.push(moduleType);
    }
    if (status) {
      where.push(`status = $${idx++}`);
      params.push(status);
    }

    // 查询总数
    const countResult = await pool.query(
      `SELECT COUNT(*) as total FROM import_logs WHERE ${where.join(' AND ')}`,
      params
    );
    const total = parseInt(countResult.rows[0].total);

    // 查询数据
    params.push(limitNum);
    params.push(offset);
    const result = await pool.query(
      `SELECT l.*, f.original_name, f.file_type, f.size
       FROM import_logs l
       LEFT JOIN file_records f ON l.file_record_id = f.id
       WHERE ${where.join(' AND ')}
       ORDER BY l.created_at DESC
       LIMIT $${idx++} OFFSET $${idx++}`,
      params
    );

    res.json(success({
      logs: result.rows,
      total,
      page: pageNum,
      limit: limitNum
    }, '查询成功'));
  } catch (err) {
    console.error('[Import] logs error:', err.message);
    res.json(error(-1, '查询日志失败: ' + err.message));
  }
});

