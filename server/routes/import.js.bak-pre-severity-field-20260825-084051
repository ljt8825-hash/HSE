// GET /api/import/stats — 导入统计
// ============================================================
router.get('/stats', requireRole('admin', 'safety_manager'), async (req, res) => {
  try {
    // 按模块统计
    const moduleStats = await pool.query(`
      SELECT module_type,
             COUNT(*) as total_imports,
             SUM(inserted_rows) as total_inserted,
             SUM(updated_rows) as total_updated,
             SUM(skipped_rows) as total_skipped,
             SUM(error_count) as total_errors
      FROM import_logs
      WHERE status = 'completed'
      GROUP BY module_type
      ORDER BY total_imports DESC
    `);

    // 最近导入
    const recent = await pool.query(`
      SELECT l.*, f.original_name
      FROM import_logs l
      LEFT JOIN file_records f ON l.file_record_id = f.id
      ORDER BY l.created_at DESC
      LIMIT 10
    `);

    // 总计
    const totals = await pool.query(`
      SELECT COUNT(*) as total_jobs,
             SUM(inserted_rows) as total_inserted,
             SUM(updated_rows) as total_updated,
             SUM(skipped_rows) as total_skipped
      FROM import_logs WHERE status = 'completed'
    `);

    res.json(success({
      byModule: moduleStats.rows,
      recent: recent.rows,
      totals: totals.rows[0]
    }, '查询成功'));
  } catch (err) {
    console.error('[Import] stats error:', err.message);
    res.json(error(-1, '查询统计失败: ' + err.message));
  }
});

// ============================================================
// 辅助函数: 调用 Python（通过 stdin 传递 JSON 参数，避免中文编码问题）
// ============================================================
function callPython(args) {
  return new Promise((resolve, reject) => {
    const startTime = Date.now();

    // 将参数写入临时 JSON 文件，避免命令行中文编码问题
    const os = require('os');
    const tmpFile = path.join(os.tmpdir(), `hse_import_${Date.now()}.json`);
    const argObj = {};
    for (const a of args) {
      if (a.startsWith('--')) {
        const eqIdx = a.indexOf('=');
        if (eqIdx > 0) {
          const key = a.substring(2, eqIdx).replace(/-/g, '_');
          argObj[key] = a.substring(eqIdx + 1);
        }
      }
    }
    // PARSER_SCRIPT 不写入 JSON
    delete argObj['undefined'];

    // 写入临时文件（必须在 spawn 之前完成）
    const fs = require('fs');
    fs.writeFileSync(tmpFile, JSON.stringify(argObj), 'utf-8');

    const { spawn } = require('child_process');

    // 安全校验: 仅允许已知的合法脚本和文件路径
    const ALLOWED_SCRIPTS = new Set([
      path.resolve(__dirname, '..', '..', 'scripts', 'import_parser.py'),
    ]);
    const resolvedScript = path.resolve(PARSER_SCRIPT);
    if (!ALLOWED_SCRIPTS.has(resolvedScript)) {
      return reject(new Error('不允许的脚本路径'));
    }

    const child = spawn(PYTHON_PATH, [
      PARSER_SCRIPT,
      '--json-input', tmpFile
    ], {
      stdio: ['pipe', 'pipe', 'pipe'],
      env: { ...process.env, PYTHONIOENCODING: 'utf-8' }
    });

    let stdout = '';
    let stderr = '';

    child.stdout.on('data', (data) => { stdout += data.toString('utf-8'); });
    child.stderr.on('data', (data) => { stderr += data.toString('utf-8'); });

    // 超时保护：30秒
    const PYTHON_TIMEOUT = parseInt(process.env.PYTHON_TIMEOUT) || 30000;
    const timeoutId = setTimeout(() => {
      console.error(`[Import] Python执行超时 (${PYTHON_TIMEOUT}ms)，强制终止`);
      child.kill('SIGTERM');
      // 给 3 秒优雅退出时间
      setTimeout(() => {
        try { child.kill('SIGKILL'); } catch(e) {}
      }, 3000);
    }, PYTHON_TIMEOUT);

    child.on('close', (code) => {
      clearTimeout(timeoutId);
      const elapsed = Date.now() - startTime;

      // 清理临时文件
      try { fs.unlinkSync(tmpFile); } catch (e) {}

      if (code !== 0) {
        console.error(`[Import] Python执行失败 (${elapsed}ms, code=${code}):`, stderr);
        return reject(new Error(stderr || `Python进程退出码: ${code}`));
      }

      try {
        const result = JSON.parse(stdout.trim());
        console.log(`[Import] Python执行完成 (${elapsed}ms)`);
        resolve(result);
      } catch (parseErr) {
        console.error('[Import] JSON解析失败:', parseErr.message);
        console.error('[Import] stdout:', stdout.substring(0, 500));
        reject(new Error('Python输出JSON解析失败: ' + parseErr.message));
      }
    });

    child.on('error', (err) => {
      clearTimeout(timeoutId);
      try { fs.unlinkSync(tmpFile); } catch (e) {}
      reject(err);
    });
  });
}

// ============================================================
// Node.js 原生导入 — 解析 Excel 文件
// ============================================================
function fixDateValue(value) {
  if (!value) return null;
  if (typeof value === 'number') {
    const date = XLSX.SSF.parse_date_code(value);
    if (date) {
      return `${date.y}-${String(date.m).padStart(2, '0')}-${String(date.d).padStart(2, '0')}`;
    }
    return null;
  }
  if (typeof value === 'string') {
    const cleaned = value.trim();
    if (!cleaned) return null;
    const dashMatch = cleaned.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
    if (dashMatch) {
      const y = parseInt(dashMatch[1], 10);
      const m = parseInt(dashMatch[2], 10);
      const d = parseInt(dashMatch[3], 10);
      if (m >= 1 && m <= 12 && d >= 1 && d <= 31) {
        return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      }
    }
    const dotMatch = cleaned.match(/^(\d{4})\.(\d{1,2})\.(\d{1,2})/);
    if (dotMatch) {
      const y = parseInt(dotMatch[1], 10);
      const m = parseInt(dotMatch[2], 10);
      const d = parseInt(dotMatch[3], 10);
      if (m >= 1 && m <= 12 && d >= 1 && d <= 31) {
        return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      }
    }
    const slashMatch = cleaned.match(/^(\d{4})\/(\d{1,2})\/(\d{1,2})/);
    if (slashMatch) {
      const y = parseInt(slashMatch[1], 10);
      const m = parseInt(slashMatch[2], 10);
      const d = parseInt(slashMatch[3], 10);
      if (m >= 1 && m <= 12 && d >= 1 && d <= 31) {
        return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      }
    }
    const d = new Date(cleaned);
    if (!isNaN(d.getTime())) {
      return d.toISOString().split('T')[0];
    }
    return null;
  }
  return null;
}

function parseExcelNative(filePath, moduleConfig, selectedSheets = null) {
  // 读文件失败：损坏 / 编码不受支持（如 GBK 编码 CSV）统一给出可操作提示
  let workbook;
  try {
    workbook = XLSX.readFile(filePath);
  } catch (e) {
    return { success: false, error: `文件无法读取或编码不受支持：请将 CSV 另存为 UTF-8 编码，或重新导出 Excel（.xlsx）后重试${e && e.message ? '（' + e.message + '）' : ''}` };
  }
  const sheetNames = workbook.SheetNames;
  if (!sheetNames.length) {
    return { success: false, error: '文件为空：没有可解析的工作表' };
  }
  const fieldMapping = moduleConfig.fieldMapping;
  const expectedHeaders = Object.keys(fieldMapping);
  const maxRows = moduleConfig.maxRows || 0;
  const fieldTypes = moduleConfig.fieldTypes || {};
  const valueTransforms = moduleConfig.valueTransforms || {};
  const requiredGroups = Array.isArray(moduleConfig.requiredColumnGroups) ? moduleConfig.requiredColumnGroups : [];
  const dedupeKey = moduleConfig.dedupeKey ? (Array.isArray(moduleConfig.dedupeKey) ? moduleConfig.dedupeKey : [moduleConfig.dedupeKey]) : null;

  function findHeaderRow(ws, maxScanRows = 20) {
    const range = XLSX.utils.decode_range(ws['!ref'] || 'A1:A1');
    const numCols = range.e.c - range.s.c + 1;
    const numRows = Math.min(maxScanRows, range.e.r - range.s.r + 1);

    let bestRow = 0;
    let bestMatch = 0;

    for (let r = 0; r < numRows; r++) {
      const rowVals = [];
      for (let c = 0; c < numCols; c++) {
        const cellAddr = XLSX.utils.encode_cell({ r, c });
        const cell = ws[cellAddr];
        const v = cell ? String(cell.v).trim() : '';
        rowVals.push(v);
      }
      const matched = expectedHeaders.filter(h => rowVals.includes(h)).length;
      if (matched > bestMatch) {
        bestMatch = matched;
        bestRow = r;
      }
      if (matched >= Math.min(expectedHeaders.length, 3)) {
        return r;
      }
    }
    return bestMatch >= 2 ? bestRow : 0;
  }

  function parseSheet(ws) {
    const headerRow = findHeaderRow(ws);
    const multiHeader = moduleConfig.multiRowHeader;

    if (multiHeader && Array.isArray(multiHeader.groupLabels) && multiHeader.groupLabels.length) {
      const groupSet = new Set(multiHeader.groupLabels);
      const groupAlias = multiHeader.groupAlias || {};
      const range = XLSX.utils.decode_range(ws['!ref'] || 'A1:A1');
      const readRowValues = (r) => {
        const vals = [];
        for (let c = range.s.c; c <= range.e.c; c++) {
          const cell = ws[XLSX.utils.encode_cell({ r, c })];
          vals.push(cell ? String(cell.v).trim() : '');
        }
        return vals;
      };
      const h1 = readRowValues(headerRow);
      const h2 = readRowValues(headerRow + 1);
      let currentGroup = '';
      const subAlias = (b) => {
        if (b === '单价/万元') return '单价(万)';
        if (b === '总价/万元') return '总价(万)';
        return b;
      };
      const combinedHeaders = h1.map((a, i) => {
        const b = h2[i] || '';
        if (a && groupSet.has(a)) {
          currentGroup = groupAlias[a] || a;
          if (b) return `${currentGroup}-${subAlias(b)}`;
          return null;
        }
        if (a) { currentGroup = ''; return a; }
        if (currentGroup && b) return `${currentGroup}-${subAlias(b)}`;
        return b || '';
      });
      return XLSX.utils.sheet_to_json(ws, {
        header: combinedHeaders,
        range: headerRow + 2,
        defval: '',
      });
    }

    const jsonData = XLSX.utils.sheet_to_json(ws, {
      defval: '',
      range: headerRow,
    });
    return jsonData;
  }

  const statusMap = moduleConfig.statusMap;
  const dateFields = moduleConfig.dateFields || [
    'hazard_date', 'fix_date', 'issue_date', 'effective_date', 'deadline',
    'installDate', 'expiryDate', 'lastCheckDate', 'nextCheckDate',
  ];

  function mapRows(jsonData, sheetName = '') {
    const allErrors = [];
    const seen = new Map(); // 文件内重复识别（按 dedupeKey 组合值）

    // 预算表：预扫描汇总行"年度安全费用预算计划总额"，提取其右侧数值（万元）作为年度计划总额，
    // 回填到本批所有有效数据行的 annual_plan_total，供统计"计划总额"卡片使用。
    let sheetAnnualPlanTotal = null;
    if (moduleConfig.moduleName === '安全费用预算') {
      for (const row of jsonData) {
        const keys = Object.keys(row);
        const labelIdx = keys.findIndex(k => String(row[k] == null ? '' : row[k]).includes('年度安全费用预算计划总额'));
        if (labelIdx >= 0) {
          for (let j = labelIdx + 1; j < keys.length; j++) {
            const v = parseFloat(row[keys[j]]);
            if (!Number.isNaN(v) && String(row[keys[j]]).trim() !== '') { sheetAnnualPlanTotal = v; break; }
          }
          if (sheetAnnualPlanTotal !== null) break;
        }
      }
    }

    const mapped = jsonData.map((row, rowIdx) => {
      const result = {};
      const rowErrors = [];
      const actualRowNum = rowIdx + 2;

      // 占位行过滤：如「X 月份无事故」等非真实记录（moduleConfig.placeholderPattern 匹配指定字段），
      // 直接跳过——不计入有效行、也不计入错误行
      if (moduleConfig.placeholderField && moduleConfig.placeholderPattern) {
        const pv = row[moduleConfig.placeholderField] != null ? String(row[moduleConfig.placeholderField]) : '';
        if (moduleConfig.placeholderPattern.test(pv)) {
          return { data: {}, errors: [], originalRow: row, rowIndex: actualRowNum };
        }
      }

      // 预算表末尾常有"年度安全费用预算计划总额"等汇总行，直接跳过
      if (moduleConfig.skipSummaryRows && moduleConfig.serialColumn) {
        const serialValue = String(row[moduleConfig.serialColumn] || '').trim();
        const summaryMarkers = /合计|汇总|总计|年度安全费用|结余|计划总额|支出总额/;
        const isLikelySummary = (serialValue && !/^\d+$/.test(serialValue)) || Object.values(row).some(v => v && summaryMarkers.test(String(v)));
        if (isLikelySummary) {
          return { data: {}, errors: [] };
        }
      }

      for (const [excelField, dbField] of Object.entries(fieldMapping)) {
        if (row[excelField] !== undefined && row[excelField] !== '') {
          let value = row[excelField];
          // 值转换（如 "80万" → 800000；转换失败 → 行级类型错误）
          const transform = valueTransforms[dbField];
          if (transform) {
            const transformed = transform(value);
            if (Number.isNaN(transformed)) {
              rowErrors.push({
                field: excelField,
                dbField,
                reason: `数值格式错误："${value}"，无法识别为金额（支持 800000 或 80万 格式）`
              });
              continue;
            }
            value = transformed;
          } else {
            // 字段类型校验（number/boolean；date 走下方 dateFields 分支）
            const ftype = fieldTypes[dbField];
            if (ftype === 'number') {
              const num = typeof value === 'number' ? value : parseFloat(String(value).trim().replace(/,/g, '').replace(/，/g, ''));
              if (Number.isNaN(num)) {
                rowErrors.push({ field: excelField, dbField, reason: `数值格式错误："${value}"，请输入数字` });
                continue;
              }
              value = num;
            } else if (ftype === 'boolean') {
              const s = String(value).trim();
              if (s === '是' || s === 'true' || s === 'TRUE' || s === '1' || s === 'yes' || s === 'YES') value = true;
              else if (s === '否' || s === 'false' || s === 'FALSE' || s === '0' || s === 'no' || s === 'NO') value = false;
              else value = (value === true || value === 1);
            }
          }
          if (dbField === 'status' && statusMap && statusMap[value]) {
            value = statusMap[value];
          }
          if (dateFields.includes(dbField)) {
            const originalValue = value;
            value = fixDateValue(value);
            if (value === null || value === 'Invalid Date') {
              rowErrors.push({
                field: excelField,
                dbField: dbField,
                reason: `日期格式错误："${originalValue}"，请使用 YYYY-MM-DD 或 YYYY/MM/DD 格式`
              });
              value = originalValue;
            }
          }
          if (value !== null && value !== '' && value !== 'Invalid Date') {
            // 预算表 item_name 常因 Excel 换行显示为多行，统一压缩空格避免冲突键匹配失败
            if (moduleConfig.moduleName === '安全费用预算' && dbField === 'item_name') {
              value = String(value).replace(/\s+/g, ' ').trim();
            }
            result[dbField] = value;
          }
        }
      }

      // 预算表：回填年度计划总额（来自汇总行扫描），仅在有效数据行上生效
      if (moduleConfig.moduleName === '安全费用预算' && sheetAnnualPlanTotal !== null) {
        result.annual_plan_total = sheetAnnualPlanTotal;
      }

      const requiredField = moduleConfig.validKey || moduleConfig.conflictKey || 'name';
      const requiredFields = Array.isArray(requiredField) ? requiredField : [requiredField];
      const hasRequiredValue = requiredFields.some(f => result[f] && String(result[f]).trim() !== '');

      if (!hasRequiredValue) {
        const isEmptyRow = Object.keys(row).every(k => !row[k] || String(row[k]).trim() === '');
        const serialValue = moduleConfig.serialColumn ? String(row[moduleConfig.serialColumn] || '').trim() : '';
        const summaryMarkers = /合计|汇总|总计|年度安全费用|结余|计划总额|支出总额/;
        const isSummaryLike = (serialValue && !/^\d+$/.test(serialValue)) || Object.values(row).some(v => v && summaryMarkers.test(String(v)));
        // 只有序号列有数字、其余列为空或 0 的填充行，视为空行
        let isFillerRow = false;
        if (moduleConfig.serialColumn && /^\d+$/.test(serialValue)) {
          isFillerRow = Object.keys(row).every(k => {
            if (k === moduleConfig.serialColumn) return true;
            const v = row[k];
            if (v === null || v === undefined || String(v).trim() === '') return true;
            return typeof v === 'number' && v === 0;
          });
        }
        if (!isEmptyRow && !isFillerRow && !isSummaryLike) {
          // 模块配置 skipRowsWithoutValidKey=true 时：validKey 字段全空的行视为非业务行直接跳过，
          // 不报「缺少必填字段」（如事故管理，只有序号/区域等辅助列有值、事故时间/类别/描述为空的行）
          if (moduleConfig.skipRowsWithoutValidKey) {
            return { data: {}, errors: [], originalRow: row, rowIndex: actualRowNum };
          }
          const requiredLabels = requiredFields.map(f => {
            const labelEntry = Object.entries(fieldMapping).find(([_, v]) => v === f);
            return labelEntry ? labelEntry[0] : f;
          });
          rowErrors.push({
            field: requiredLabels.join(' / '),
            dbField: requiredFields.join(','),
            reason: `缺少必填字段，至少需要填写：${requiredLabels.join('、')}`
          });
        }
      }

      // name/title 双向互补仅对明确声明 titleFromName 的模块生效
      // （regulations / safety_goals 表含 title 列；其余目标表如 risk_sources /
      //   emergency_plans 无 title 列，注入 title 会导致 INSERT 报「字段不存在」）
      if (moduleConfig.titleFromName) {
        if (!result.name && result.title) {
          result.name = result.title;
        }
        if (!result.title && result.name) {
          result.title = result.name;
        }
      }
      if (moduleConfig.moduleName === '消防设施管理' && result.siteName) {
        if (result.location) {
          result.location = `${result.siteName} - ${result.location}`;
        } else {
          result.location = result.siteName;
        }
        delete result.siteName;
      }
      if (moduleConfig.moduleName === '目标职责') {
        delete result.name;
        const parts = [];
        if (row['年度']) parts.push(`年度：${row['年度']}`);
        if (row['目标值']) parts.push(`目标值：${row['目标值']}`);
        if (row['完成值']) parts.push(`完成值：${row['完成值']}`);
        if (row['考核周期']) parts.push(`考核周期：${row['考核周期']}`);
        if (parts.length) result.content_summary = parts.join('；');
      }

      // 文件内重复识别：同 dedupeKey 组合值出现多次 → 标记重复行（避免重复投保/重复录入）
      if (dedupeKey && rowErrors.length === 0) {
        const keyStr = dedupeKey
          .map(k => (result[k] !== undefined && result[k] !== null ? String(result[k]).trim() : ''))
          .join('||');
        if (keyStr && keyStr.replace(/\|\|/g, '')) {
          if (seen.has(keyStr)) {
            rowErrors.push({
              field: dedupeKey.join('+'),
              dbField: 'duplicate',
              reason: `与第 ${seen.get(keyStr)} 行重复（${dedupeKey.join('+')} 相同），请检查清单`
            });
          } else {
            seen.set(keyStr, actualRowNum);
          }
        }
      }

      if (rowErrors.length > 0) {
        allErrors.push({
          rowIndex: actualRowNum,
          sheetName: sheetName,
          errors: rowErrors
        });
      }

      return { data: result, errors: rowErrors, originalRow: row, rowIndex: actualRowNum };
    });
    return { mapped, allErrors };
  }

  const sheets = [];
  let allData = [];
  let allRowErrors = [];
  let globalRowOffset = 0;
  let totalScannedRows = 0;
  // 表头必填列检测：仅对第一个"数据表"（表头匹配 >=2）执行，避免封面/说明 sheet 误伤
  let firstDataSheetChecked = false;

  for (const sheetName of sheetNames) {
    const ws = workbook.Sheets[sheetName];
    const rawData = parseSheet(ws);

    // 行数限制（累计所有 sheet 数据行）
    totalScannedRows += rawData.length;
    if (maxRows > 0 && totalScannedRows > maxRows) {
      return {
        success: false,
        error: `数据行数超出限制（最多 ${maxRows} 行），请拆分文件后分批导入`,
        sheets,
      };
    }

    // 表头必填列检测（requiredColumnGroups 每组至少匹配一个别名）
    if (!firstDataSheetChecked && requiredGroups.length && rawData.length > 0) {
      const headerKeys = Object.keys(rawData[0]).map(h => String(h).trim());
      const matchedColsCount = expectedHeaders.filter(h => headerKeys.includes(h)).length;
      if (matchedColsCount >= 2) {
        firstDataSheetChecked = true;
        const missing = [];
        for (const group of requiredGroups) {
          const hasAny = group.some(alias => headerKeys.includes(alias) || headerKeys.some(k => k.includes(alias)));
          if (!hasAny) missing.push(group.join('/'));
        }
        if (missing.length) {
          return {
            success: false,
            error: `缺少必填列：${missing.join('、')}。请使用模板表头（如 ${requiredGroups.map(g => g[0]).join('、')}），当前表头：${headerKeys.join('、') || '（空）'}`,
            sheets,
          };
        }
      }
    }

    const { mapped, allErrors } = mapRows(rawData, sheetName);
    const requiredField = moduleConfig.validKey || moduleConfig.conflictKey || 'name';
    const requiredFields = Array.isArray(requiredField) ? requiredField : [requiredField];
    // validKeySkipErrors：true 时只判断 requiredFields 是否非空，不再过滤 errors.length；
    // 用于「描述非空即视为有效」的宽容导入场景（如事故统计表，行级日期/必填缺失不影响入库）
    const validRows = mapped.filter((item) => {
      const valid = requiredFields.some((f) => item.data[f] != null && String(item.data[f]).trim() !== '');
      return moduleConfig.validKeySkipErrors ? valid : (valid && item.errors.length === 0);
    });
    const matchedCols = expectedHeaders.filter(h => {
      if (rawData.length === 0) return false;
      const firstRow = rawData[0];
      return Object.keys(firstRow).includes(h);
    }).length;
    // 模块自定义的辅助 sheet 黑名单（如事故管理的「单位」「类别关联」等数据字典）
    const excludedByName = Array.isArray(moduleConfig.excludeSheetPatterns)
      && moduleConfig.excludeSheetPatterns.some((re) => re.test(sheetName));

    const sheetInfo = {
      name: sheetName,
      row_count: rawData.length,
      valid_count: validRows.length,
      error_count: allErrors.length,
      matched_cols: matchedCols,
      is_data_sheet: !excludedByName && (validRows.length > 0 || allErrors.length > 0) && matchedCols >= 2,
    };
    sheets.push(sheetInfo);

    // 默认仅合并真正的"数据 sheet"（matched_cols >= 2 且有数据/错误），
    // 跳过分析摘要/数据来源清单等非数据 sheet（避免非结构化文本被误判为无效行）
    const shouldMerge = excludedByName
      ? false
      : (selectedSheets === null
        ? sheetInfo.is_data_sheet
        : selectedSheets.includes(sheetName));
    if (shouldMerge) {
      allData = allData.concat(mapped);
      allRowErrors = allRowErrors.concat(allErrors.map(e => ({ ...e, rowIndex: e.rowIndex + globalRowOffset })));
      globalRowOffset += rawData.length;
    }
  }

  const requiredField = moduleConfig.validKey || moduleConfig.conflictKey || 'name';
  const requiredFields = Array.isArray(requiredField) ? requiredField : [requiredField];
  // 与 per-sheet validRows 一致：validKeySkipErrors=true 时只看 requiredFields 非空，忽略 errors
  const validItems = allData.filter((item) => {
    const valid = requiredFields.some((f) => item.data[f] != null && String(item.data[f]).trim() !== '');
    return moduleConfig.validKeySkipErrors ? valid : (valid && item.errors.length === 0);
  });
  const validData = validItems.map(item => item.data);
  const errorItems = allData.filter(item => item.errors.length > 0);

  // 编码异常启发式：所有 sheet 表头均无法匹配（matched_cols < 2）且首行含 UTF-8 解码失败特征（U+FFFD）
  // → 提示编码问题（常见于 GBK 编码 CSV 被按 UTF-8 读取产生替换符乱码）
  if (totalScannedRows > 0 && sheets.every((s) => s.matched_cols < 2)) {
    const firstSheet = workbook.Sheets[sheetNames[0]];
    const firstGrid = firstSheet ? XLSX.utils.sheet_to_json(firstSheet, { defval: '', header: 1, range: 0, limit: 1 }) : [];
    const joined = JSON.stringify(firstGrid || []);
    if (joined.includes('\uFFFD')) {
      return {
        success: false,
        error: '文件编码异常：检测到无法识别的字符（常见于 GBK 编码的 CSV 文件）。请将文件另存为 UTF-8 编码后重试',
        sheets,
      };
    }
  }

  if (!validData.length && errorItems.length === 0) {
    return { success: false, error: '文件中没有有效数据，请检查表头是否匹配', sheets };
  }

  const preview = validData.slice(0, 10).map((row, i) => ({
    rowIndex: i + 1,
    data: camelKeys(row),
    errors: [],
  })).concat(
    errorItems.slice(0, 5).map(item => ({
      rowIndex: item.rowIndex,
      data: camelKeys(item.data),
      errors: item.errors,
    }))
  );

  return {
    success: true,
    module_type: moduleConfig.moduleName,
    target_table: moduleConfig.targetTable,
    total_rows: validData.length,
    error_count: errorItems.length,
    errors: allRowErrors,
    sample_data: validData,
    preview,
    sheets,
  };
}

// ============================================================
// Node.js 原生导入 — 确认入库
// ============================================================
// 厂牌车型清洗：去掉「吸污车/车厢可卸式垃圾车/自装卸式垃圾车/载货汽车」前方的文字/字母/数字，仅保留关键字及其后内容
// 与 server/routes/insurance.js 的 cleanModel 保持一致，确保导入落库与列表展示/筛选逻辑统一
function cleanModel(raw) {
  if (!raw || typeof raw !== 'string') return raw;
  const keywords = ['吸污车', '车厢可卸式垃圾车', '自装卸式垃圾车', '载货汽车'];
  let cut = -1;
  for (const kw of keywords) {
    const i = raw.indexOf(kw);
    if (i >= 0 && (cut === -1 || i < cut)) cut = i;
  }
  return cut >= 0 ? raw.slice(cut) : raw;
}

async function confirmImportNative(fileRecordId, moduleType, operator, insuranceType) {
  const moduleConfig = NATIVE_IMPORT_MODULES[moduleType];
  if (!moduleConfig) {
    return { success: false, error: `不支持的模块: ${moduleType}` };
  }

  // ---- 内存模式模块（fire-facility / violation 等）：导入到内存存储 ----
  if (moduleConfig.memoryMode) {
    return confirmImportMemory(fileRecordId, moduleType, moduleConfig, operator);
  }

  // ---- 网格管理双模式：数据库不可用时降级到内存存储 ----
  if (moduleType === 'grid' && !isConnected()) {
    return confirmImportMemory(fileRecordId, moduleType, { ...moduleConfig, memoryMode: true }, operator);
  }

  const fr = await pool.query(
    'SELECT filepath, original_name FROM file_records WHERE id = $1',
    [fileRecordId]
  );
  if (!fr.rows.length) {
    return { success: false, error: '文件记录不存在' };
  }

  const filePath = fr.rows[0].filepath;
  const parseResult = parseExcelNative(filePath, moduleConfig);
  if (!parseResult.success) {
    return parseResult;
  }

  let data = parseResult.sample_data || [];
  console.log('[NativeImport] 初始数据量:', data.length);

  // 数据清洗：移除空值字段，转换数字字段类型
  const numericFields = moduleConfig.numericFields || ['duration_minutes', 'score', 'premium', 'amount', 'quantity'];
  data = data.map(row => {
    const cleaned = {};
    for (const [key, value] of Object.entries(row)) {
      if (value === null || value === undefined || value === '') {
        continue;
      }
      if (numericFields.includes(key)) {
        const num = Number(value);
        if (!isNaN(num)) {
          cleaned[key] = num;
        }
      } else {
        cleaned[key] = value;
      }
    }
    return cleaned;
  });

  // 人员保险导入：若指定了保险类型（导入雇主险 / 导入工伤险），
  // 对未填写保险类型的行自动补齐默认值，确保列表按险种 Tab 正确筛选。
  if (moduleType === 'personnel' && insuranceType) {
    data = data.map((row) => ({ ...row, insurance_type: row.insurance_type || insuranceType }));
  }

  // 安全费用预算：补齐必填/默认值，保证旧模板或无年度列也能正常写入。
  if (moduleType === 'budget') {
    const currentYear = new Date().getFullYear();
    data = data.map((row) => {
      const next = { ...row };
      if (next.budget_year === undefined || next.budget_year === null || next.budget_year === '') {
        let derivedYear = currentYear;
        if (next.plan_time) {
          const pt = String(next.plan_time);
          const m = pt.match(/^(\d{4})/);
          if (m) derivedYear = parseInt(m[1], 10);
        }
        next.budget_year = derivedYear;
      }
      if (next.use_status === undefined || next.use_status === null || next.use_status === '') {
        next.use_status = '未支出';
      }
      // 计划总价未填写时自动计算（单价单位为万元）
      if ((next.plan_total === undefined || next.plan_total === null) && typeof next.plan_quantity === 'number' && typeof next.plan_unit_price === 'number') {
        next.plan_total = Number((next.plan_quantity * next.plan_unit_price).toFixed(4));
      }
      // 未提供预算金额/已用金额时，用计划/支出总价推导（单位均为万元）
      if ((next.budget_amount === undefined || next.budget_amount === null) && typeof next.plan_total === 'number') {
        next.budget_amount = next.plan_total;
      }
      if ((next.spent_amount === undefined || next.spent_amount === null) && typeof next.actual_quantity === 'number' && typeof next.actual_unit_price === 'number') {
        next.spent_amount = Number((next.actual_quantity * next.actual_unit_price).toFixed(4));
      }
      return next;
    });
  }

  // 过滤掉缺少必填字段（name）的记录，避免数据库 NOT NULL 报错
  if (moduleType === 'ledger') {
    const before = data.length;
    data = data.filter(row => row.name && String(row.name).trim() !== '');
    const filtered = before - data.length;
    console.log('[NativeImport] name过滤前:', before, '过滤后:', data.length, '过滤掉:', filtered);
    if (data.length > 0) {
      console.log('[NativeImport] 第一条数据:', JSON.stringify(data[0]));
      console.log('[NativeImport] 字段列表:', Object.keys(data[0]).join(', '));
    }
  }

  // 网格管理（任务四）：写入 grid_inspection_records
  // 1) 由 upload_time 派生 inspection_date（取日期部分）
  // 2) 按 片区/班组 + 网格等级 模糊关联 grid_areas.id（匹配不上留空仍计入该检查人次数）
  if (moduleType === 'grid') {
    data = data.map((row) => {
      let inspectionDate = null;
      if (row.upload_time) {
        const d = fixDateValue(row.upload_time);
        if (d && d !== 'Invalid Date') inspectionDate = String(d).slice(0, 10);
      }
      return { ...row, inspection_date: inspectionDate };
    });

    // 预取去重的 (片区/班组, 网格等级) 组合，批量匹配网格，避免逐行查询
    const distinctCombos = [...new Set(data.map((r) => `${r.area_team || ''}|||${r.grid_level || ''}`))];
    const gridMatchMap = new Map();
    for (const combo of distinctCombos) {
      const [area, level] = combo.split('|||');
      if (!area) { gridMatchMap.set(combo, null); continue; }
      try {
        const r = await pool.query(
          `SELECT id FROM grid_areas
           WHERE is_deleted = false AND grid_level = $1 AND (name = $2 OR name ILIKE $3)
           ORDER BY id LIMIT 1`,
          [level || '', area, `%${area}%`]
        );
        gridMatchMap.set(combo, r.rows.length ? r.rows[0].id : null);
      } catch (e) {
        gridMatchMap.set(combo, null);
      }
    }
    data = data.map((row) => {
      const combo = `${row.area_team || ''}|||${row.grid_level || ''}`;
      return { ...row, grid_id: gridMatchMap.get(combo) ?? null };
    });
  }

  // 人员保险（任务8）：共享 employeeResolver 解析 employee.id 并注入服务端快照。
  // 姓名不单独自动匹配；ID/工号矛盾、姓名不一致、零/多候选、缺员工、日期错误、险种不支持、
  // 重复当前保单均逐行标记 _import_error（保留原始行号供 rowErrors 定位），错误行不写入。
  if (moduleType === 'personnel') {
    const rows = [];
    for (let idx = 0; idx < data.length; idx++) {
      const row = { ...data[idx], _import_row_no: idx + 1 };
      const fail = (reason) => { row._import_error = reason; };
      // 日期起止顺序校验
      if (row.start_date && row.expire_date && String(row.start_date) > String(row.expire_date)) {
        fail('date_order_invalid');
        rows.push(row);
        continue;
      }
      // 险种规范化（任务4）：工伤险->工伤保险；意外伤害险/五险/未知 -> unsupported（阻止写库）
      const canonicalType = normalizeInsuranceType(row.insurance_type);
      if (!canonicalType) {
        fail('unsupported_insurance_type');
        rows.push(row);
        continue;
      }
      row.insurance_type = canonicalType;
      // 共享人员解析（任务2）：单条创建/直接导入/通用导入复用同一生产解析器。
      // idCard（证件号码，明文）经 employeeResolver 按 id_card_hash 解析员工（雇主险清单无工号场景）
      const resolved = await resolveEmployee({
        employeeId: row.employee_id,
        employeeCode: row.employee_code,
        idCard: row.id_card,
      });
      if (!resolved.employee) {
        fail(resolved.reason || 'employee_not_found');
        rows.push(row);
        continue;
      }
      const employee = resolved.employee;
      // 姓名附加一致性校验：提供姓名且与主数据不一致 → 逐行失败（姓名不能单独命中）
      if (!isNameConsistent(row.person_name, employee)) {
        fail('name_mismatch');
        rows.push(row);
        continue;
      }
      // 险种必填（规范化后为空即未提供）
      if (!row.insurance_type || String(row.insurance_type).trim() === '') { fail('missing_insurance_type'); rows.push(row); continue; }
      // is_current 值规范化（'是'/'否'/true/false）
      if (row.is_current !== undefined && row.is_current !== null) {
        row.is_current = (row.is_current === true || row.is_current === 1 || String(row.is_current).trim() === '是' || String(row.is_current).trim() === '1');
      } else {
        row.is_current = true;
      }
      // 任务9：当前有效冲突检查不在预处理阶段执行——必须在确认 UPDATE 目标（employee_id+险种+保单号）
      // 之后再以 excludeId=目标ID 检查，否则会把自己识别为冲突导致正常 UPDATE 不可达。
      // 冲突检查由 confirmImportNative 的 personnel 专用阶段执行（见下方模块Type分支）。
      row.employee_id = employee.employee_id;
      row.person_name = employee.name;
      row.department = employee.org_name || '';
      row.position = employee.position_name || '';
      // 内部元数据：_import_row_no / employee_code 仅用于错误定位，写库前由列白名单投影剔除（任务1）
      rows.push(row);
    }
    data = rows;
  }

  // 三违管理：根据花名册岗位自动判断三违类型（仅当为空时填充）
  if (moduleType === 'violation' && data.length > 0) {
    const targetPositions = ['保洁员', '驾驶员', '挂桶工', '转运站操作工', '转运站管理员', '转运站操作员'];
    const allNames = [...new Set(data.map(r => r.violator_name).filter(Boolean))];
    const empMap = new Map();
    if (allNames.length > 0) {
      const placeholders = allNames.map((_, i) => `$${i + 1}`).join(',');
      const empResult = await pool.query(
        `SELECT name, org_name, position_name FROM v_employee_org_full
         WHERE name = ANY($1) AND is_deleted = false AND is_current = true`,
        [allNames]
      );
      empResult.rows.forEach(row => {
        const key = `${row.name}|${row.org_name || ''}`;
        if (!empMap.has(key)) empMap.set(key, row.position_name);
        const shortKey = row.name;
        if (!empMap.has(shortKey)) empMap.set(shortKey, row.position_name);
      });
    }
    data = data.map(row => {
      const currentType = row.violation_type_result;
      if (currentType && currentType.trim() !== '') return row;
      const name = row.violator_name || '';
      const area = row.area_team || '';
      let position = null;
      if (area) {
        for (const [key, pos] of empMap.entries()) {
          const [n, org] = key.split('|');
          if (n === name && org && org.includes(area)) { position = pos; break; }
        }
      }
      if (!position) position = empMap.get(name) || null;
      if (position && targetPositions.some(tp => position.includes(tp))) {
        return { ...row, violation_type_result: '违反劳动纪律' };
      }
      return row;
    });
  }

  // 三违管理：初始化可选字段键，确保 INSERT 列集合稳定（首行缺字段会导致后续行不写入）
  // 并抽取 Excel 内嵌图片关联到数据行（通用化，复用 extract_violation_images.py）
  if (moduleType === 'violation' && data.length > 0) {
    for (const row of data) {
      if (row.nickname === undefined) row.nickname = null;
      if (row.mark === undefined) row.mark = null;
      if (row.is_supplementary === undefined) row.is_supplementary = null;
      if (row.image_content === undefined) row.image_content = '';
      if (row.rectification_photos === undefined) row.rectification_photos = '';
    }
    try {
      const imgResult = await attachViolationImages(filePath, data);
      console.log('[NativeImport] 三违图片关联:', imgResult);
    } catch (imgErr) {
      console.warn('[NativeImport] 三违图片关联异常（不影响数据导入）:', imgErr.message);
    }
  }

  // 车辆保险：导入落库前清洗厂牌车型 + 兜底商业险合计 + 兜底保费合计，保证重导后存储值与列表展示/筛选一致
  if (moduleType === 'vehicle') {
    for (const row of data) {
      if (row.model) row.model = cleanModel(row.model);
      // 源表无「商业险合计」列时，按商业险子项（三者/车损/司乘保费）汇总
      const ct = parseFloat(row.commercial_total);
      if (!(ct > 0)) {
        row.commercial_total = (parseFloat(row.third_party_premium) || 0)
          + (parseFloat(row.vehicle_damage_premium) || 0)
          + (parseFloat(row.passenger_premium) || 0);
      }
      // 源表「合计」常仅含交强险+车船税（漏加商业险）；按 交强险+商业险合计+车船税 重算
      const tp = parseFloat(row.total_premium);
      const expectedTp = (parseFloat(row.compulsory_premium) || 0)
                       + (parseFloat(row.commercial_total) || 0)
                       + (parseFloat(row.vehicle_tax) || 0);
      if (!(tp > 0) && expectedTp > 0) {
        row.total_premium = expectedTp;
      }
    }
  }

  const tableName = moduleConfig.targetTable;
  const conflictKey = moduleConfig.conflictKey;

  let inserted = 0;
  let updated = 0;
  let skipped = 0;

  // personnel 模块：预处理标记的错误行（missing/multiple/not_found/id_code_conflict/name_mismatch/
  // date_order_invalid/missing_insurance_type 等）进入逐行错误结果（含原始行号与标识），不写入。
  // 任务9：rowErrors 为稳定结构化对象 {row, reason, message, employeeCode}，不再返回自由文本数组。
  const importRowErrors = [];
  let totalRowsBeforeFilter = data.length;
  if (moduleType === 'personnel') {
    const valid = [];
    for (const row of data) {
      if (row._import_error) {
        importRowErrors.push({
          row: row._import_row_no != null ? row._import_row_no : null,
          reason: row._import_error,
          message: row._import_error,
          employeeCode: row.employee_code != null ? String(row.employee_code) : null,
        });
        continue;
      }
      valid.push(row);
    }
    data = valid;
  }

  console.log('[NativeImport] data length:', data.length);
  if (data.length > 0) {
    console.log('[NativeImport] first row keys:', Object.keys(data[0]));
  }

  const conflictKeys = Array.isArray(conflictKey) ? conflictKey : conflictKey ? [conflictKey] : [];
  console.log('[NativeImport] conflictKeys:', conflictKeys);

  const rowsWithConflict = [];
  const rowsWithoutConflict = [];
  for (const row of data) {
    const hasConflictValue = conflictKeys.length > 0 && conflictKeys.every((k) => row[k] !== undefined && row[k] !== '');
    if (hasConflictValue) {
      rowsWithConflict.push(row);
    } else {
      rowsWithoutConflict.push(row);
    }
  }
  console.log('[NativeImport] 有冲突键数据:', rowsWithConflict.length, '无冲突键数据:', rowsWithoutConflict.length);

  const existingMap = new Map();
  if (rowsWithConflict.length > 0 && conflictKeys.length > 0) {
    try {
      const values = [];
      const conditions = rowsWithConflict.map((row, rowIdx) => {
        const rowConditions = conflictKeys.map((k, colIdx) => {
          values.push(row[k]);
          const paramIdx = rowIdx * conflictKeys.length + colIdx + 1;
          return `${k} = $${paramIdx}`;
        });
        return `(${rowConditions.join(' AND ')})`;
      }).join(' OR ');
      const softDeletedClause = moduleConfig.reactivateSoftDeleted ? '' : ' AND is_deleted = false';
      const existingResult = await pool.query(
        `SELECT * FROM ${tableName} WHERE (${conditions})${softDeletedClause}`,
        values
      );
      for (const row of existingResult.rows) {
        const key = conflictKeys.map(k => String(row[k])).join('|||');
        existingMap.set(key, row);
      }
    } catch (e) {
      // 任务9：personnel 模块冲突目标批量查询失败必须 fail-closed——不得把 existingMap 当空继续
      // INSERT（会绕过 UPDATE 目标识别产生重复记录）。其他模块保持原有降级行为。
      if (moduleType === 'personnel') {
        console.error('[NativeImport] 人员保险冲突目标批量查询失败（fail-closed，本次导入中止）:', e.message);
        return {
          success: false,
          inserted: 0,
          updated: 0,
          skipped: data.length,
          total: totalRowsBeforeFilter,
          rowErrors: importRowErrors.concat([{ row: null, reason: 'duplicate_check_failed', message: '冲突目标查询失败，请稍后重试', employeeCode: null }]),
        };
      }
      console.error('[NativeImport] 批量查询失败，降级为逐条处理:', e.message);
    }
  }

  let toInsert = [];
  let toUpdate = [];

  // 任务1（提示词08）：写库对象由显式列白名单投影生成。
  // dbColumns 存在时（如 personnel），批量/逐条/UPDATE 只用白名单列，内部元数据
  // （_import_row_no/_import_error/employee_code 等）绝不进入 SQL 标识符；
  // 列顺序稳定（不依赖第一行偶然拥有的 key），缺失可选字段以 NULL 占位。
  // 任务9：行上下文（原始行号/安全员工标识）与 dbRow 分离，投影后不丢失。
  const dbColumns = Array.isArray(moduleConfig.dbColumns) ? moduleConfig.dbColumns : null;

  function projectToDbColumns(row) {
    if (!dbColumns) return { ...row };
    const out = {};
    for (const col of dbColumns) {
      const v = row[col];
      // 空字符串/undefined/null 统一为 null 占位，保持列顺序与值位置稳定
      out[col] = (v === undefined || v === null || v === '') ? null : v;
    }
    return out;
  }

  /** 构造带行上下文与 dbRow 的写库项（personnel 模块使用；其他模块保持 dbRow 直存） */
  function buildWriteItem(row, extra = {}) {
    const dbRow = projectToDbColumns(row);
    if (!dbColumns) return dbRow;
    return {
      dbRow,
      sourceRowNo: row._import_row_no != null ? row._import_row_no : null,
      sourceEmployeeCode: row.employee_code != null ? String(row.employee_code) : null,
      ...extra,
    };
  }

  for (const row of rowsWithoutConflict) {
    toInsert.push(buildWriteItem(row));
  }

  for (const row of rowsWithConflict) {
    const key = conflictKeys.map(k => String(row[k])).join('|||');
    const existing = existingMap.get(key);
    if (existing) {
      if (moduleType === 'violation') {
        skipped++;
      } else {
        toUpdate.push(buildWriteItem(row, { id: existing.id, reactivate: existing.is_deleted === true }));
      }
    } else {
      toInsert.push(buildWriteItem(row));
    }
  }

  // 任务9：personnel 模块专用冲突检查阶段（必须在识别 UPDATE 目标之后执行）。
  //  - 命中明确 UPDATE 目标（同 employee_id + 规范险种 + policy_no）→ 冲突查询 excludeId=目标ID
  //  - 无 UPDATE 目标（INSERT）→ 检查全部当前有效保单（无 excludeId）
  //  - 空保单号不能作为不稳定 UPDATE 标识 → 按 INSERT 场景查重并拒绝并行当前有效记录
  //  - 查询异常 fail-closed（duplicate_check_failed），该行不写库
  // 任务1（提示词11）：批内集合必须是"已接受最终事实"，不是"开始检查"：
  //  - 统一候选列表 { operation, item, sourceRowNo } 按原始源行号稳定排序逐行校验，
  //    不再先全部 INSERT 再全部 UPDATE（文件靠后的 INSERT 不得抢占靠前 UPDATE 的判定）
  //  - active key 仅在全部通过（active 纯函数 true + 无已接受批内同 key + DB 冲突查询成功
  //    + 无外部 active 冲突）后才加入；被 duplicate_active_policy/duplicate_check_failed/
  //    duplicate_target_in_batch 拒绝的行不占用 accepted key，也不阻断后续独立校验
  //  - 同一 UPDATE 目标以源行顺序为准只接受首个"完整通过"的行；首行失败不占位
  //  - 预处理已把 is_current 规范为 boolean（未提供默认 true），此处直接传规范值，
  //    禁止用 !== false 把 null/undefined 提升为 true
  if (moduleType === 'personnel') {
    const batchActiveKeys = new Set();       // 已接受且完整通过校验的 active 最终事实（employee_id + canonicalType）
    const acceptedUpdateTargets = new Set(); // 已接受且完整通过校验的 UPDATE 目标（employee_id + type + policy_no）

    const candidates = [
      ...toInsert.map((item) => ({ operation: 'insert', item, sourceRowNo: item.sourceRowNo != null ? item.sourceRowNo : Number.MAX_SAFE_INTEGER })),
      ...toUpdate.map((item) => ({ operation: 'update', item, sourceRowNo: item.sourceRowNo != null ? item.sourceRowNo : Number.MAX_SAFE_INTEGER })),
    ].sort((a, b) => a.sourceRowNo - b.sourceRowNo);

    const checkedInsert = [];
    const checkedUpdate = [];
    for (const cand of candidates) {
      const { operation, item } = cand;
      const r = item.dbRow || item;
      const failRow = (reason, message) => {
        importRowErrors.push({ row: item.sourceRowNo, reason, message, employeeCode: item.sourceEmployeeCode });
        skipped++;
      };
      // UPDATE 目标重复：仅首个"完整通过"的目标占用；首行失败时后续行独立校验
      if (operation === 'update') {
        const targetKey = `${r.employee_id}|${r.insurance_type}|${String(r.policy_no || '')}`;
        if (acceptedUpdateTargets.has(targetKey)) {
          failRow('duplicate_target_in_batch', '同一续保/更新目标（员工+险种+保单号）在文件中重复出现，仅接受第一条');
          continue;
        }
      }
      const isActive = r.employee_id != null && r.insurance_type != null
        && isPolicyActiveOnBusinessDay({ isCurrent: r.is_current, startDate: r.start_date, expireDate: r.expire_date });
      if (isActive) {
        const key = `${r.employee_id}|${r.insurance_type}`;
        if (batchActiveKeys.has(key)) {
          failRow('duplicate_active_policy_in_batch', `本批次已接受同一员工同险种（${r.insurance_type}）的当前有效保单`);
          continue;
        }
        // 数据库冲突查询成功且无外部冲突后才可视为"已接受"（失败行不占 key）
        const conflict = operation === 'update'
          ? await findActivePolicyConflict({ employeeId: r.employee_id, insuranceType: r.insurance_type, excludeId: item.id })
          : await findActivePolicyConflict({ employeeId: r.employee_id, insuranceType: r.insurance_type });
        if (conflict.error) {
          failRow('duplicate_check_failed', '重复保单检查失败，请稍后重试');
          continue;
        }
        if (conflict.conflict) {
          failRow('duplicate_active_policy', operation === 'update'
            ? `排除更新目标后仍存在当前有效${r.insurance_type}（保单ID ${conflict.conflict.id}）`
            : `已存在当前有效${r.insurance_type}（保单ID ${conflict.conflict.id}）`);
          continue;
        }
        batchActiveKeys.add(key); // 完整通过后才占用 accepted key
      }
      if (operation === 'update') {
        acceptedUpdateTargets.add(`${r.employee_id}|${r.insurance_type}|${String(r.policy_no || '')}`);
        checkedUpdate.push(item);
      } else {
        checkedInsert.push(item);
      }
    }
    toInsert = checkedInsert;
    toUpdate = checkedUpdate;
  }
  console.log('[NativeImport] 待插入:', toInsert.length, '待更新:', toUpdate.length, '已跳过:', skipped);

  const BATCH_SIZE = 100;

  if (toInsert.length > 0) {
    // 白名单优先：列顺序稳定；无白名单的模块保留旧行为（Object.keys 首行）
    // 任务9：personnel 写库项为 { dbRow, sourceRowNo, sourceEmployeeCode }，取值用 item.dbRow
    const firstItem = toInsert[0];
    const columns = dbColumns || Object.keys(firstItem.dbRow || firstItem);
    const getRow = (item) => (item && item.dbRow) ? item.dbRow : item;
    for (let i = 0; i < toInsert.length; i += BATCH_SIZE) {
      const batch = toInsert.slice(i, i + BATCH_SIZE);
      const placeholders = [];
      const values = [];
      let paramIdx = 1;
      for (const item of batch) {
        const row = getRow(item);
        const rowPlaceholders = columns.map((_, ci) => `$${paramIdx + ci}`).join(', ');
        placeholders.push(`(${rowPlaceholders})`);
        for (const col of columns) {
          values.push(row[col] === undefined ? null : row[col]);
        }
        paramIdx += columns.length;
      }
      try {
        await pool.query(
          `INSERT INTO ${tableName} (${columns.join(', ')}) VALUES ${placeholders.join(', ')}`,
          values
        );
        inserted += batch.length;
      } catch (e) {
        console.error(`[NativeImport] 批量插入失败 (batch ${i}-${i + batch.length}):`, e.message);
        console.error('[NativeImport] 失败批次第一条数据:', JSON.stringify(batch[0]));
        console.error('[NativeImport] 列名:', columns.join(', '));
        let firstRowErrorLogged = false;
        for (const item of batch) {
          const row = getRow(item);
          try {
            // 逐条降级 INSERT 同样使用白名单列（与批量路径一致），内部元数据不泄漏
            const cols = dbColumns || Object.keys(row);
            const ph = cols.map((_, ci) => `$${ci + 1}`).join(', ');
            await pool.query(
              `INSERT INTO ${tableName} (${cols.join(', ')}) VALUES (${ph})`,
              cols.map(c => (row[c] === undefined ? null : row[c]))
            );
            inserted++;
          } catch (e2) {
            if (!firstRowErrorLogged) {
              console.error('[NativeImport] 逐条插入第一条失败数据:', JSON.stringify(row));
              console.error('[NativeImport] 逐条插入错误:', e2.message);
              firstRowErrorLogged = true;
            }
            // 任务9：保留原始行号并返回结构化安全错误（不泄漏 e2.message 的列名/连接信息）
            if (moduleType === 'personnel') {
              importRowErrors.push({ row: item.sourceRowNo, reason: 'write_failed', message: '写入失败，请稍后重试', employeeCode: item.sourceEmployeeCode });
            } else {
              importRowErrors.push(`${item.sourceRowNo != null ? `第${item.sourceRowNo}行` : ''} 逐条写入失败: ${e2.message}`);
            }
            skipped++;
          }
        }
      }
    }
  }

  for (const item of toUpdate) {
    // 任务9：personnel 写库项为 { dbRow, sourceRowNo, id, reactivate }
    const row = (item && item.dbRow) ? item.dbRow : item;
    const id = item.id;
    const reactivate = item.reactivate;
    const sourceRowNo = item.sourceRowNo;
    const sourceEmployeeCode = item.sourceEmployeeCode;
    try {
      const setClauses = [];
      const values = [];
      let idx = 0;
      // UPDATE 同样只使用白名单列（personnel 等有 dbColumns 的模块）；
      // 无白名单模块保留旧行为（Object.entries 全字段）
      const updateKeys = dbColumns || Object.keys(row);
      for (const key of updateKeys) {
        const value = row[key];
        if (key !== 'id' && value !== undefined && value !== null && value !== '') {
          idx++;
          setClauses.push(`${key} = $${idx}`);
          values.push(value);
        }
      }
      if (reactivate) {
        idx++;
        setClauses.push(`is_deleted = $${idx}`);
        values.push(false);
      }
      if (setClauses.length) {
        idx++;
        values.push(id);
        await pool.query(
          `UPDATE ${tableName} SET ${setClauses.join(', ')}, updated_at = NOW() WHERE id = $${idx}`,
          values
        );
      }
      updated++;
    } catch (e) {
      // 任务9：UPDATE 失败保留行号并返回结构化安全错误（不泄漏 e.message）
      console.error(`[NativeImport] 更新失败:`, e.message);
      if (moduleType === 'personnel') {
        importRowErrors.push({ row: sourceRowNo, reason: 'update_failed', message: '更新失败，请稍后重试', employeeCode: sourceEmployeeCode });
      }
      skipped++;
    }
  }

  // 任务4（提示词11）：导入结果状态诚实表达 imported/partial/failed。
  //  - imported：有成功写入且无跳过/错误
  //  - partial：有成功写入且有跳过/错误
  //  - failed：零成功写入（存在跳过/错误或空结果），不得虚报为完整成功
  const wroteCount = inserted + updated;
  const hasErrors = skipped > 0 || importRowErrors.length > 0;
  const outcome = (!hasErrors && wroteCount > 0) ? 'imported' : (wroteCount > 0 ? 'partial' : 'failed');

  try {
    await pool.query(
      `UPDATE file_records SET module_type = $1, status = $2 WHERE id = $3`,
      [moduleType, outcome, fileRecordId]
    );
  } catch (e) {
    // 文件状态更新失败：不得先返回成功；仅服务端日志 + 安全错误（不泄漏 SQL/host/port 文本）
    console.error('[NativeImport] file_records 状态更新失败（不向前端泄漏）:', e.message);
    return {
      success: false,
      error: '文件状态更新失败，请稍后重试',
      inserted,
      updated,
      skipped,
      total: totalRowsBeforeFilter,
      outcome,
      ...(importRowErrors.length > 0 ? { rowErrors: importRowErrors } : {}),
    };
  }

  // 任务四：网格检查记录导入完成后，触发完成率重算（写回 grid_areas.completion_rate）
  if (moduleType === 'grid' && isConnected()) {
    try {
      const recalc = await gridCompletionService.recalculateAllCompletionRates();
      console.log(`[NativeImport] 网格完成率重算完成，影响 ${recalc.updated} 个网格`);
    } catch (e) {
      console.warn('[NativeImport] 网格完成率重算失败（不影响导入结果）:', e.message);
    }
  }

  return {
    success: true,
    inserted,
    updated,
    skipped,
    total: totalRowsBeforeFilter,
    outcome,
    ...(importRowErrors.length > 0 ? { rowErrors: importRowErrors } : {}),
  };
}

// ============================================================
// 三违图片通用抽取（被 confirmImportNative 调用）
// ============================================================
async function attachViolationImages(filePath, data) {
  if (!data || data.length === 0) return { attached: 0, skipped: true };
  const mapPath = path.join(os.tmpdir(), `violation_img_map_${Date.now()}_${Math.random().toString(36).slice(2)}.json`);
  return new Promise((resolve) => {
    const uploadsRoot = path.join(__dirname, '..', 'uploads');
    const child = execFile(
      PYTHON_PATH,
      [EXTRACT_IMG_SCRIPT, '--xlsx', filePath, '--out', uploadsRoot, '--map', mapPath],
      { timeout: 180000, maxBuffer: 64 * 1024 * 1024 },
      (err, stdout, stderr) => {
        try { fs.unlinkSync(mapPath); } catch (e) { /* ignore */ }
        if (err) {
          console.warn('[Import] 三违图片抽取失败（不影响数据导入）:', err.message);
          if (stderr) console.warn('[Import] extract stderr:', stderr.slice(0, 500));
          return resolve({ attached: 0, error: err.message });
        }
        try {
          const map = JSON.parse(fs.readFileSync(mapPath, 'utf-8'));
          const norm = (s) => (s == null ? '' : String(s).trim().replace(/\s+/g, ' '));
          const noMap = new Map();
          const keyMap = new Map();
          for (const e of map) {
            const urls = { threeViolation: e.threeViolation || [], rectification: e.rectification || [] };
            if (e.no) noMap.set(norm(e.no), urls);
            const k = [norm(e.area_team), norm(e.inspector_name), norm(e.violator_name), norm(e.violation_behavior), norm(e.grid_level), norm(e.violation_date)].join('\u0001');
            if (k.replace(/\u0001/g, '')) keyMap.set(k, urls);
          }
          let attached = 0;
          for (const row of data) {
            const hit = noMap.get(norm(row.no)) || keyMap.get(
              [norm(row.area_team), norm(row.inspector_name), norm(row.violator_name), norm(row.violation_behavior), norm(row.grid_level), norm(row.violation_date)].join('\u0001')
            );
            if (hit) {
              row.image_content = hit.threeViolation.join(',');
              row.rectification_photos = hit.rectification.join(',');
              attached++;
            }
          }
          console.log('[Import] 三违图片关联完成，命中', attached, '行（共', data.length, '行）');
          resolve({ attached });
        } catch (parseErr) {
          console.warn('[Import] 三违图片映射解析失败（不影响数据导入）:', parseErr.message);
          resolve({ attached: 0, error: parseErr.message });
        }
      }
    );
  });
}

// ============================================================
// 内存模式导入（fire-facility / violation / grid / over-age 等模块）
// ============================================================
async function confirmImportMemory(fileRecordId, moduleType, moduleConfig, operator) {
  let memoryStores, memoryCounters, initMemoryData;

  if (moduleType === 'over-age') {
    ({ memoryStores, memoryCounters } = require('./insurance'));
    initMemoryData = () => {};
  } else {
    ({ memoryStores, memoryCounters, initMemoryData } = require('./site-mgmt'));
  }

  initMemoryData();

  const storeMap = {
    'fire-facility': 'fireEquipment',
    'violation': 'violations',
    'grid': 'gridInspectionRecords',
    'over-age': 'overage',
    'objectives': 'objectives',
  };
  const counterMap = {
    'fire-facility': 'fireEquipment',
    'violation': 'violations',
    'grid': 'gridInspectionRecords',
    'over-age': 'overage',
    'objectives': 'objectives',
  };
  const storeKey = storeMap[moduleType];
  const counterKey = counterMap[moduleType];
  if (!storeKey || !counterKey) {
    return { success: false, error: `不支持的内存模块: ${moduleType}` };
  }

  const fr = await pool.query(
    'SELECT filepath, original_name FROM file_records WHERE id = $1',
    [fileRecordId]
  );
  if (!fr.rows.length) {
    return { success: false, error: '文件记录不存在' };
  }

  const filePath = fr.rows[0].filepath;
  const parseResult = parseExcelNative(filePath, moduleConfig);
  if (!parseResult.success) {
    return parseResult;
  }

  let data = parseResult.sample_data || [];

  // 网格管理内存降级：仅派生 inspection_date（grid_id 在内存模式无法关联，留空）
  if (moduleType === 'grid') {
    data = data.map((row) => {
      let inspectionDate = null;
      if (row.upload_time) {
        const d = fixDateValue(row.upload_time);
        if (d && d !== 'Invalid Date') inspectionDate = String(d).slice(0, 10);
      }
      return { ...row, inspection_date: inspectionDate, grid_id: null };
    });
  }

  const conflictKey = moduleConfig.conflictKey;
  const store = memoryStores[storeKey];
  const counter = memoryCounters;

  let inserted = 0;
  let updated = 0;
  let skipped = 0;

  function matchConflictKey(r, row) {
    if (!conflictKey) return false;
    const keys = Array.isArray(conflictKey) ? conflictKey : [conflictKey];
    return keys.every((k) => r[k] === row[k]);
  }

  for (const row of data) {
    try {
      const record = {
        id: counter[counterKey],
        is_deleted: false,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        ...row,
      };

      const conflictKeys = Array.isArray(conflictKey) ? conflictKey : conflictKey ? [conflictKey] : [];
      const hasConflictValue = conflictKeys.length > 0 && conflictKeys.every((k) => row[k] !== undefined && row[k] !== '');

      if (hasConflictValue) {
        const existingIdx = store.findIndex(
          (r) => matchConflictKey(r, row) && !r.is_deleted
        );
        if (existingIdx >= 0) {
          store[existingIdx] = {
            ...store[existingIdx],
            ...row,
            updatedAt: new Date().toISOString(),
          };
          updated++;
        } else {
          record.id = counter[counterKey];
          store.push(record);
          counter[counterKey]++;
          inserted++;
        }
      } else {
        record.id = counter[counterKey];
        store.push(record);
        counter[counterKey]++;
        inserted++;
      }
    } catch (e) {
      console.error(`[MemoryImport] 导入失败:`, e.message);
      skipped++;
    }
  }


  // 任务4（提示词12-残余风险收口）：内存导入 outcome 语义与原生导入对齐
  //  - imported：有成功写入且无跳过/错误
  //  - partial：有成功写入且有跳过/错误
  //  - failed：零成功写入（存在跳过/错误或空结果），不得虚报为完整成功
  const wroteCount = inserted + updated;
  const hasErrors = skipped > 0;
  const outcome = (!hasErrors && wroteCount > 0) ? 'imported' : (wroteCount > 0 ? 'partial' : 'failed');

  try {
    await pool.query(
      `UPDATE file_records SET module_type = $1, status = $2 WHERE id = $3`,
      [moduleType, outcome, fileRecordId]
    );
  } catch (e) {
    // 文件状态更新失败：仅服务端日志 + 安全错误（不泄漏 SQL/host/port 文本）
    console.error('[MemoryImport] file_records 状态更新失败（不向前端泄漏）:', e.message);
    return {
      success: false,
      error: '文件状态更新失败，请稍后重试',
      inserted,
      updated,
      skipped,
      total: data.length,
      outcome,
    };
  }

  auditLog({
    userId: operator?.id || null,
    username: operator?.username || 'system',
    action: 'import',
    module: moduleType,
    description: `导入 ${inserted + updated} 条数据（内存模式）`,
    ip: '',
  }).catch(() => {});

  return {
    success: true,
    inserted,
    updated,
    skipped,
    total: data.length,
    outcome,
  };
}

