// POST /api/import/upload — 上传 Excel 文件并解析
// 前端(ImportModal)仅调用此接口与 /confirm：
//   1) multer 落盘
//   2) 写入 file_records 记录（id 作为 jobId 回传前端，供 /confirm 使用）
//   3) 调 Python 引擎解析（--file-record-id 使其回写 module_type/data_period/status）
//   4) 将 sample_data 转换为前端 preview 结构并返回
// 与旧 mock 的响应字段完全兼容（preview/totalRows/validRows/invalidRows/jobId/moduleType）
// 上传为写操作，要求管理员/安全管理角色
// ============================================================
router.post('/upload', requireRole('admin', 'safety_manager'), (req, res, next) => {
  console.log('[Upload Debug] === 收到上传请求 ===');
  console.log('[Upload Debug] Content-Type:', req.headers['content-type']);
  console.log('[Upload Debug] Content-Length:', req.headers['content-length']);
  uploadExcel.single('file')(req, res, (err) => {
    if (err) {
      console.error('[Upload Debug] multer 错误:', err.message);
      return res.json(error(-1, err.message || '文件上传失败'));
    }
    console.log('[Upload Debug] multer 完成, req.file:', req.file ? req.file.originalname + ' (' + req.file.size + ' bytes)' : 'undefined');
    console.log('[Upload Debug] req.fileValidationError:', req.fileValidationError);
    console.log('[Upload Debug] req.body.module:', req.body?.module);
    next();
  });
}, async (req, res) => {
  try {
    if (!req.file) {
      return res.json(error(-1, '请选择要上传的文件'));
    }

    // 统一路径为正斜杠（Python 引擎要求）
    const filePath = req.file.path.replace(/\\/g, '/');
    let fileName = req.file.originalname;
    const fileSize = req.file.size;

    // ---- 中文文件名 Mojbibake（乱码）检测与修复 ----
    // 某些客户端（非RFC 5987编码的FormData）中文文件名会被 busboy 按 Latin-1 解码，
    // 导致 UTF-8 字节被错误解释为 å® ä¹‹ç‰ 乱码模式。
    // 修复策略：检测乱码 → 尝试从原始字节重建 UTF-8 → 回退到表单字段 original_filename
    const backupName = req.body.original_filename || req.body.originalFilename || '';
    fileName = repairMojibakeFileName(fileName, backupName);

    // 辅助函数：检测并修复 Mojibake 文件名
    function repairMojibakeFileName(original, fallback) {
      if (!original) return fallback || 'unknown.xlsx';

      // 检测特征：含 â¤ çš å½ ç› ç‰ 典型 Mojibake 子串（UTF-8 被 Latin-1 解码的特征）
      const mojibakePattern = /[â€¦â€°â€¡â€¢â€™â€œâ€â€œå¤§éˆ™©ç®¡æŽ§æ¸…å•]/;

      if (mojibakePattern.test(original)) {
        // 尝试 Latin-1 → UTF-8 反向转换
        try {
          const repaired = Buffer.from(original, 'latin1').toString('utf-8');
          // 验证修复结果是否包含合理的中文字符（Unicode CJK 范围）
          if (/[\u4e00-\u9fff\u3000-\u303f]/.test(repaired)) {
            console.log('[Import] Mojibake 修复:', original.substring(0, 30), '→', repaired);
            return repaired;
          }
        } catch (e) { /* 忽略 */ }
      }

      // 如果提供了回退名且当前名看起来不像正常的中文文件名，使用回退名
      if (fallback && /[\x80-\xff]{2,}/.test(original) && !/[\u4e00-\u9fff]/.test(original)) {
        console.log('[Import] 使用回退文件名:', fallback);
        return fallback;
      }

      return original;
    }

    const fileType = (path.extname(fileName) || '').toLowerCase().replace(/^\./, '') || 'xlsx';

    // 1) 写入 file_records（状态 uploaded），拿到自增 id 作为 jobId
    const insertRes = await pool.query(
      `INSERT INTO file_records (filename, filepath, original_name, file_type, size, status, created_at)
       VALUES ($1, $2, $3, $4, $5, 'uploaded', NOW()) RETURNING id`,
      [req.file.filename, filePath, fileName, fileType, fileSize]
    );
    const fileRecordId = insertRes.rows[0].id;

    const module = req.body.module || '';
    const nativeConfig = NATIVE_IMPORT_MODULES[module];

    // 优先使用 Node.js 原生导入（如果配置了）
    if (nativeConfig) {
      try {
        const parseResult = parseExcelNative(req.file.path, nativeConfig);
        if (!parseResult.success) {
          return res.json(error(-2, parseResult.error || '文件解析失败', parseResult));
        }

        await pool.query(
          `UPDATE file_records SET module_type = $1, status = 'parsed' WHERE id = $2`,
          [module, fileRecordId]
        );

        const payload = {
          jobId: String(fileRecordId),
          totalRows: parseResult.total_rows + (parseResult.error_count || 0),
          validRows: parseResult.total_rows,
          invalidRows: parseResult.error_count || 0,
          errors: parseResult.errors || [],
          preview: parseResult.preview,
          moduleType: module,
          moduleName: nativeConfig.moduleName,
          targetTable: nativeConfig.targetTable,
          sheets: parseResult.sheets || [],
        };
        return res.json(success(payload, `文件上传并解析成功: ${fileName}${parseResult.error_count ? `（错误${parseResult.error_count}行，已跳过）` : ''}`));
      } catch (nativeErr) {
        console.error('[Import] native parse failed:', nativeErr.message);
      }
    }

    // 2) 调 Python 解析引擎（带 file_record_id，回写 module_type/data_period/status='parsed'）
    const args = [
      PARSER_SCRIPT,
      '--action=parse',
      `--file-path=${filePath}`,
      `--file-name=${fileName}`,
      `--file-record-id=${fileRecordId}`,
    ];

    let parseResult;
    try {
      parseResult = await callPython(args);
    } catch (pyErr) {
      console.error('[Import] parse spawn failed:', pyErr.message);
      return res.json(error(-2, '文件解析失败（解析引擎异常）: ' + pyErr.message));
    }

    if (!parseResult || !parseResult.success) {
      return res.json(error(-2, parseResult?.error || '文件解析失败', parseResult || null));
    }

    // 3) 转换为与前端契约一致的结构（与 /parse 共用 buildFrontendPreview）
    const payload = buildFrontendPreview(parseResult, fileRecordId);

    // 4) 返回与前端契约一致的响应（兼容旧 mock 字段）
    res.json(success(payload, `文件上传并解析成功: ${fileName}`));
  } catch (err) {
    console.error('[Import] upload error:', err.message);
    res.json(error(-1, '上传失败: ' + err.message));
  }
});

