// ========== GET /:id/attachments — 附件列表 ==========
router.get('/:id/attachments', async (req, res, next) => {
  try {
    const { id } = req.params;
    const { version } = req.query;

    if (!isConnected()) {
      initMemoryData();
      let data = memoryAttachments.filter(a => a.accident_id === parseInt(id) && !a.is_deleted);
      if (version) data = data.filter(a => a.version === version);
      data.sort((a, b) => (b.is_latest ? 1 : 0) - (a.is_latest ? 1 : 0) || new Date(b.created_at) - new Date(a.created_at));
      return res.json(success(data.map(camelKeys), '查询成功(内存模式)'));
    }

    await ensureTables();
    let sql = 'SELECT * FROM accident_attachments WHERE accident_id = $1 AND is_deleted = FALSE';
    const params = [id];
    if (version) {
      sql += ' AND version = $2';
      params.push(version);
    }
    sql += ' ORDER BY is_latest DESC, created_at DESC';

    const result = await pool.query(sql, params);
    res.json(success(result.rows.map(camelKeys), '查询成功'));
  } catch (err) {
    console.error('[Accident] 查询事故附件失败:', err.message);
    res.json(error(-1, '操作失败，请稍后重试'));
  }
});

// ========== POST /:id/attachments — 上传附件 ==========
router.post('/:id/attachments', requireRole('admin', 'safety_manager'), uploadDocument.single('file'), async (req, res, next) => {
  try {
    const { id } = req.params;
    if (!req.file) return sendValidationError(res, '请上传文件');

    const { version = '1.0', uploaded_by = 'admin' } = req.body;
    const fileUrl = getFileUrl(req, req.file.filename, 'documents');
    const originalName = fixFilenameEncoding(req.file.originalname);

    if (!isConnected()) {
      initMemoryData();
      // 旧版本标记为非最新
      memoryAttachments.forEach(a => {
        if (a.accident_id === parseInt(id) && a.is_latest) a.is_latest = false;
      });
      const record = buildMemoryRecord(memoryAttachmentIdCounter++, {
        accident_id: parseInt(id),
        filename: req.file.filename,
        original_name: originalName,
        file_type: 'document',
        file_size: req.file.size,
        file_url: fileUrl,
        version,
        uploaded_by,
        is_latest: true,
      });
      memoryAttachments.push(record);
      return res.json(success(camelKeys(record), '上传成功(内存模式)'));
    }

    await ensureTables();

    // 数据库模式：旧版本标记为非最新
    await pool.query(
      'UPDATE accident_attachments SET is_latest = FALSE WHERE accident_id = $1 AND is_latest = TRUE',
      [id]
    );

    const result = await pool.query(`
      INSERT INTO accident_attachments (accident_id, filename, original_name, file_type, file_size, file_url, version, uploaded_by, is_latest)
      VALUES ($1, $2, $3, $4, $5, $6, $7, $8, TRUE)
      RETURNING *
    `, [id, req.file.filename, originalName, 'document', req.file.size, fileUrl, version, uploaded_by]);

    auditLog({ userId: req.user?.id, username: req.user?.username, action: 'upload_attachment', module: 'accidents', description: `上传事故附件 事故ID=${id}`, ip: req.ip }).catch(() => {});
    res.json(success(camelKeys(result.rows[0]), '上传成功'));
  } catch (err) {
    console.error('[Accident] 上传事故附件失败:', err.message);
    res.json(error(-1, '操作失败，请稍后重试'));
  }
});

