// ========== DELETE /:id — 软删除 ==========
router.delete('/:id', requireRole('admin', 'safety_manager'), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    if (isNaN(id)) return res.json(error(-1, '参数错误：ID必须为数字'));
    if (!isConnected()) {
      initMemoryData();
      const record = memoryRecords.find(r => r.id === id && !r.is_deleted);
      if (!record) return res.json(error(-2, '记录不存在'));
      record.is_deleted = true;
      return res.json(success(null, '删除成功(内存模式)'));
    }

    const result = await pool.query(
      'UPDATE accidents SET is_deleted = true, updated_at = CURRENT_TIMESTAMP WHERE id = $1 AND is_deleted = false RETURNING id',
      [id]
    );
    if (result.rows.length === 0) return res.json(error(-2, '记录不存在'));
    auditLog({ userId: req.user?.id, username: req.user?.username, action: 'delete', module: 'accidents', description: `删除事故 ID=${id}`, ip: req.ip }).catch(() => {});
    res.json(success(null, '删除成功'));
  } catch (err) {
    console.error('[Accident] 删除事故失败:', err.message);
    res.json(error(-1, '操作失败，请稍后重试'));
  }
});

