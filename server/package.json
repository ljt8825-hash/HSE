{
  "name": "safety-dashboard-server",
  "version": "2.0.0",
  "description": "宁津项目HSE安全管理系统后端服务 (Node.js/Express/PostgreSQL, 唯一入口 app.js)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "build": "node --check app.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:integration": "node scripts/check-integration-gate.cjs && cross-env NODE_ENV=test ALLOW_INTEGRATION_TESTS=true jest --config jest.integration.config.js",
    "test:integration:coverage": "node scripts/check-integration-gate.cjs && cross-env NODE_ENV=test ALLOW_INTEGRATION_TESTS=true jest --config jest.integration.config.js --coverage"
  },
  "keywords": [
    "hse",
    "safety",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "HSE Data Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^4.4.3"
  }
}
