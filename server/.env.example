# ============================================================
# HSE 安全管理系统 - 环境变量示例文件
# ============================================================
# 用途：复制为 .env 并填入真实值后使用
# 复制命令（PowerShell）：Copy-Item .env.example .env
# ⚠️ 真实 .env 文件包含敏感信息，请勿提交到版本控制
# ============================================================

# ============================================================
# JWT 认证配置
# ============================================================
# ⚠️ 生产环境必须替换为强随机密钥（建议使用 openssl rand -hex 64 生成）
JWT_SECRET=please_change_this_to_a_strong_random_secret
JWT_REFRESH_SECRET=please_change_this_to_a_strong_random_refresh_secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# 数据库配置（PostgreSQL）
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=hse_app
DB_PASSWORD=please_change_this_to_a_strong_db_password
DB_NAME=safety_dashboard

# 管理员密码（仅用于紧急维护，对应 postgres 超级用户）
POSTGRES_PASSWORD=please_change_this_to_a_strong_postgres_password

# ============================================================
# 服务配置
# ============================================================
NODE_ENV=development
PORT=5666
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5666,http://127.0.0.1:5666

# ============================================================
# 数据加密配置
# ============================================================
# ⚠️ 生产环境必须替换为强随机密钥（建议使用 openssl rand -hex 64 生成）
DATA_ENCRYPTION_KEY=please_change_this_to_a_strong_encryption_key

# ============================================================
# Cache（缓存配置）
# ============================================================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300000
CACHE_MAX_SIZE=10000

# ============================================================
# BI（大屏数据缓存）
# ============================================================
BI_CACHE_TTL=30000

# ============================================================
# IoT（物联网设备配置）
# ============================================================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ============================================================
# Rate Limit per endpoint（各接口限流）
# ============================================================
RATE_LIMIT_BI_MAX=1000
RATE_LIMIT_IOT_MAX=2000

# ============================================================
# AI Service（AI 服务配置）
# ============================================================
AI_PROVIDER=grok
GROK_API_KEY=
GROK_MODEL=grok-2
GROK_BASE_URL=https://api.x.ai/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# 视觉识图（Ollama VL）专用超时：CPU 推理 + 模型首次加载，远慢于文本 AI，不可复用 AI_TIMEOUT_MS
OLLAMA_VL_TIMEOUT_MS=300000
# 签到表识别：模型承认是签到表但内容全空时自动重跑次数（0~3，默认 1）
AI_SIGNIN_RETRY=1

# ---- 视觉识图传输通道（2026-10-19 新增；不配=保持原 Ollama 行为）----
# 可选值：ollama（默认）| openai（任意 OpenAI 兼容网关，含本机 dsh「本地 OpenAI 网关」）
# 说明：只填 VISION_OPENAI_BASE_URL 而不填 VISION_PROVIDER，也会自动切到 openai 通道。
# VISION_PROVIDER=ollama
# VISION_OPENAI_BASE_URL=http://127.0.0.1:18899/v1
# VISION_OPENAI_MODEL=nvidia/nemotron-3.5-super-vl:free
# VISION_OPENAI_API_KEY=
# 网关超时（默认沿用 OLLAMA_VL_TIMEOUT_MS / AI_TIMEOUT_MS / 300s）
# VISION_OPENAI_TIMEOUT_MS=300000
# response_format 策略：auto=先带、被拒再去掉重试（默认）| on=必带 | off=不带
# VISION_OPENAI_JSON_MODE=auto
# 网关瞬时错误（502/503/504/408/429 或网络层错误）自动重发一次的等待毫秒数，默认 2000，配 0 表示不等
# 仅对 openai/DSH 通道生效；本地 Ollama 不重试
# VISION_TRANSIENT_RETRY_DELAY_MS=2000

# ---- DSH 本地网关（培训记录页「DSH 识别」开关打开时使用；全不配则用下面的默认值）----
# key 默认自动读 ~/.dsh/our-free-model/settings.json 的 forwardKey，通常无需手工填
# DSH_BASE_URL=http://127.0.0.1:18899/v1
# DSH_MODEL=nvidia/nemotron-3.5-super-vl:free
# DSH_API_KEY=
# DSH_TIMEOUT_MS=300000
# DSH_JSON_MODE=auto
# 追加下拉框里的模型（逗号分隔；默认白名单已含 4 个实测可识图的 kilo 模型 + 5 个 EAC 模型）
# DSH_VISION_MODELS=

# ============================================================
# Python 路径（可选，仅 AI 增强功能使用）
# ============================================================
PYTHON_PATH=

# ============================================================
# WPS 多维表接入层（Sprint-WPS-01）
# 仅服务端配置，禁止出现在前端 / 提交到 Git。
# 取值参照 WPS 开放平台开发者后台与目标 .dbt 多维表。
# ============================================================
# WPS OpenAPI 基础地址（默认 https://openapi.wps.cn）
WPS_OPENAPI_BASE=https://openapi.wps.cn
# 开放平台应用凭证（应用授权 client_credentials）
WPS_APP_ID=
WPS_APP_SECRET=
# 多维表格文件 ID（.dbt 文件）
WPS_DBSHEET_FILE_ID=
# 数据表 ID（sheet id）
WPS_DBSHEET_SHEET_ID=
# 是否启用 KSO-1 API 签名头（开发者后台开启签名时设 true）
WPS_API_SIGNATURE=false
# 请求超时（毫秒），默认 30000
WPS_TIMEOUT_MS=30000
# 网格长巡查台账双向同步开关（'false' 才整体关闭；凭证齐全时默认启用）
WPS_GRID_SYNC=true
# 是否允许 WPS 端删除回删 PG（默认关，仅记录）
WPS_SYNC_DELETE=false
# 下行推送截止时间（ISO 日期；首次启用后历史数据不下发 WPS）
WPS_SYNC_PUSH_CUTOFF=
# WPS Webhook 回调密钥（公网部署启用时校验）
WPS_WEBHOOK_SECRET=
# WPS 轮询对账 cron（默认每 15 分钟）
WPS_SYNC_CRON=*/15 * * * *

# ============================================================
# PC「网格长巡查台账」数据源切换（Sprint-WPS-02）
# ============================================================
# false：PC 台账继续使用 PostgreSQL（默认，零行为变化）
# true ：且上面 WPS 凭证完整时，PC 台账改为读写 WPS 多维表（见 services/wps/gridDataSource.js）
#        —— 身份由后端从当前登录用户解析，禁止前端伪造巡查人员身份
WPS_GRID_DATA_SOURCE=false
