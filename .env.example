# ============================================================
# 宁津环卫 HSE 安全管理系统 — 环境变量配置示例
# 复制为 .env 后修改相应值
# ============================================================

# ---- 应用配置 ----
APP_PORT=8080
APP_NAME=宁津环卫HSE安全管理系统
APP_ENV=production
APP_DEBUG=false

# ---- 数据库配置 (PostgreSQL) ----
POSTGRES_DB=safety_dashboard
POSTGRES_USER=hse_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# 后端数据库连接
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=safety_dashboard
DB_USER=hse_user
DB_PASSWORD=your_strong_password_here
DB_POOL_MIN=2
DB_POOL_MAX=20

# ---- JWT 认证配置 ----
# ⚠️ 必须修改！生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64
# ⚠️ 必须修改！生成方式同上，使用另一个不同的密钥
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64_another
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---- 多租户配置 (可选) ----
# 默认 false (单租户模式), 设置 true 开启多租户
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT_ID=1

# ---- 文件上传配置 ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar

# ---- 前端配置 ----
VITE_API_BASE_URL=/api
VITE_APP_TITLE=宁津环卫HSE安全管理系统
VITE_APP_ENV=production

# ---- Sentry 错误监控 (可选) ----
# 生产环境建议配置，留空则不启用
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=v3.0.0

# ---- WebSocket 配置 ----
WS_ENABLED=true
WS_HEARTBEAT_INTERVAL=30000

# ---- 日志配置 ----
LOG_LEVEL=info
LOG_DIR=logs

# ---- Docker 配置 ----
COMPOSE_PROJECT_NAME=hse-app
TZ=Asia/Shanghai

# ---- 安全配置 ----
# Trust Proxy 层数（Nginx 反代设为 1，有 CDN 时设为 2）
TRUST_PROXY=1

# ---- Python 解释器路径（用于智能导入功能） ----
PYTHON_PATH=/usr/bin/python3

# ---- 敏感数据加密 ----
# AES-256-GCM 加密密钥（用于身份证号/手机号等敏感字段）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 生产环境必须设置！开发环境有内置默认值
DATA_ENCRYPTION_KEY=
