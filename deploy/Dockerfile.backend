# ============================================================
# Dockerfile.backend — HSE 安全管理系统后端 (Node.js)
# 基于 Node.js 22 生产镜像，仅安装生产依赖
# 宁津环卫 HSE 安全管理系统 v4.1
# ============================================================

FROM node:22-slim

# 设置时区
ENV TZ=Asia/Shanghai

# 创建非 root 用户运行应用（安全最佳实践）
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --shell /bin/false nodejs

WORKDIR /app

# 先复制依赖声明文件，利用 Docker 缓存层
COPY server/package*.json ./

# 仅安装生产依赖（排除 devDependencies）
RUN npm ci --production && npm cache clean --force

# 复制后端源代码
COPY server/ ./

# 创建上传目录并设置权限
RUN mkdir -p uploads/documents uploads/excel uploads/file-records uploads/hazards uploads/images && \
    chown -R nodejs:nodejs /app

# 切换到非 root 用户
USER nodejs

# 暴露 API 服务端口
EXPOSE 3000

# 健康检查（每15秒检测一次，超时5秒，连续3次失败标记不健康）
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# 启动后端服务
CMD ["node", "app.js"]
