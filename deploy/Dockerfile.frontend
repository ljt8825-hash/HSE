# ============================================================
# Dockerfile.frontend — HSE 安全管理系统前端 (Vben Admin)
# 多阶段构建: Node.js 构建 → Nginx 静态服务
# 宁津环卫 HSE 安全管理系统 v4.1
# ============================================================

# ---- 阶段1: 构建前端产物 ----
FROM node:22-alpine AS builder

# 启用 corepack 以支持 pnpm
RUN corepack enable

# 设置时区（确保构建时间戳正确）
ENV TZ=Asia/Shanghai

# 设置 Node.js 内存上限（Vben 项目构建需要较大内存）
ENV NODE_OPTIONS=--max-old-space-size=8192

# CI 环境标志（禁止交互式提示）
ENV CI=true

WORKDIR /app

# 先复制依赖文件，利用 Docker 缓存层加速后续构建
COPY 安全看板vben/package.json 安全看板vben/pnpm-lock.yaml ./
COPY 安全看板vben/pnpm-workspace.yaml ./

# 安装依赖（frozen-lockfile 确保版本一致性）
RUN pnpm install --frozen-lockfile

# 复制完整源码
COPY 安全看板vben/ ./

# 执行生产构建（Naive UI 版本，当前主应用）
RUN pnpm run build:naive

# ---- 阶段2: Nginx 静态文件服务 ----
FROM nginx:alpine

# 复制构建产物到 Nginx 默认静态目录
COPY --from=builder /app/apps/web-naive/dist /usr/share/nginx/html

# 复制 Nginx 反向代理配置
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# 暴露 HTTP 端口
EXPOSE 80

# 启动 Nginx（前台运行）
CMD ["nginx", "-g", "daemon off;"]
