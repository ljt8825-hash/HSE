# ============================================
# HSE 安全管理系统 - .gitignore
# ============================================

# ---- 环境变量 ----
# 包含数据库密码、JWT 密钥等敏感信息
.env
.env.production
.env.local
.env.docker
server/.env

# ---- 依赖 ----
node_modules/
server/node_modules/

# ---- 构建产物 ----
server/dist/

# ---- 备份文件 ----
backups/
*.bak
*.sql.gz

# ---- 日志 ----
logs/
*.log
server/error.log
server/combined.log

# ---- 操作系统 ----
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- IDE ----
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- 上传文件 ----
# 生产环境上传的文件不应在版本控制中
server/uploads/*
!server/uploads/.gitkeep

# ---- 临时文件 ----
temp/
tmp/
*.tmp

# ---- 测试覆盖率 ----
coverage/
server/coverage/

# ---- Python 临时文件 ----
__pycache__/
*.pyc
*.pyo

