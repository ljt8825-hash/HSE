.env.production.local
.env.staging

# 日志 — 补充
*.log.gz

# 备份 — 补充
*.dump

# 构建产物 — 补充（顶层）
dist/
build/

# IDE — 补充（完整忽略 .vscode）
.vscode/

# PM2 进程管理
pids/
*.pid

# Docker 持久化数据
postgres_data/
pgdata/

# 测试 — 补充
.nyc_output/

# 临时文件 — 补充
.workbuddy/


