*.bak
*.tmp


# ============================================
# 收敛型源码基线 (2026-09-12) — 排除构建/探测/临时产物
# ============================================

# 构建缓存与前端 dist 备份（dist.bak.* / dist_esbk_* / dist_verify_* ...）
_build_cache/
.dist_cache/
dist/
dist*/
**/dist*/
dist.bak.*/
dist_*/
**/dist_*/
*.tsbuildinfo
.turbo/
.cache/

# 工具/平台本地目录（非源码）
.trae/
.trae-html-share-packages/
.workbuddy/
.playwright-cli/
playwright-report/
test-results/
safe_verify/
_14_chrome_profile/
_18_chrome_profile/

# 探测与诊断输出（server 根 ad-hoc 产物）
server/_*.txt
server/_*.json
server/_*.log
server/_debug_*.js
[0-9][0-9]_*.txt
[0-9][0-9]_*.json
[0-9][0-9]_*.cjs
[0-9][0-9]_*.sh
[0-9][0-9][0-9]_*.cjs
[0-9][0-9][0-9]_*.txt
*_sider_dump*.txt
*_curl_tmp*.txt
*_n1_retest*.cjs

# 运行时导出/数据目录（非源码）
导出文件/
测试数据/
数据源/
final/
monitoring/
logstash/
uploads/
server/uploads/
export/
server/export/
data/
server/data/
dbbackup/
server/dbbackup/

# 根级临时/一次性/验证目录（以 / 锚定根目录，避免误伤前端 views/_core）
/_test_venv/
/_zod_extract/
/_express_extract/
/_08_2_backup/
/_03b_shots/
/_0904_sanjian/
/_0905_transfer_station/
/_0907_accident_analysis_backup/
/_0908_kdocs_sanwei/
/_acc_input_verify/
/_official_ref/
/_test_npm/
/_backup_packages_*/
/_backups/
/_verify/
/_verify_shots/
/_verify_tmp/
/_02b_dbg_upload.cjs
verify_naive/
server/test-uploads/

# server/scripts 下的验证截图（非源码；保留 scripts 内代码脚本）
server/scripts/**/*.jpg
server/scripts/**/*.jpeg
server/scripts/**/*.png
server/scripts/**/*.gif

# Windows 保留设备名（git add 会因索引失败而中断整个 add）
/nul
/con
/prn
/aux
/com1
/com2
/com3
/lpt1

