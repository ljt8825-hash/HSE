{
  "module": "training",
  "dependsOn": {
    "employeeFields": ["employeeId", "employeeName", "deptName", "positionName", "orgStatus"],
    "events": ["EMPLOYEE_TRANSFERRED", "EMPLOYEE_RESIGNED", "EMPLOYEE_STATUS_CHANGED"],
    "queries": ["getEmployeesByIds", "getEmployeeSelectorList"],
    "components": ["EmployeeSelector", "EmployeeName"]
  },
  "provides": {
    "employeeStats": ["trainingCompletionRate", "trainingHours"],
    "events": ["TRAINING_COMPLETED", "TRAINING_OVERDUE"]
  }
}
