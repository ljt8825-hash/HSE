{
  "module": "violations",
  "dependsOn": {
    "employeeFields": ["employeeId", "employeeName", "deptName", "positionName", "orgStatus"],
    "events": ["EMPLOYEE_TRANSFERRED", "EMPLOYEE_RESIGNED", "EMPLOYEE_INFO_UPDATED"],
    "queries": ["getEmployeesByIds", "getEmployeeSelectorList"],
    "components": ["EmployeeSelector", "EmployeeName"]
  },
  "provides": {
    "employeeStats": ["violationCount", "violationScore"],
    "events": ["VIOLATION_RECORDED"]
  }
}
