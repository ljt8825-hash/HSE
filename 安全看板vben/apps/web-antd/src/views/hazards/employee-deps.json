{
  "module": "hazards",
  "dependsOn": {
    "employeeFields": ["employeeId", "employeeName", "deptName", "positionName"],
    "events": ["EMPLOYEE_TRANSFERRED", "EMPLOYEE_RESIGNED", "EMPLOYEE_INFO_UPDATED"],
    "queries": ["getEmployeesByIds", "getEmployeeSelectorList"],
    "components": ["EmployeeSelector", "EmployeeName"]
  },
  "provides": {
    "employeeStats": ["hazardCount", "rectificationRate"],
    "events": ["HAZARD_REPORTED", "HAZARD_RECTIFIED"]
  }
}
